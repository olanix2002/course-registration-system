# Copy this file to .env for local development. Never commit .env.
# On Render, set these in the service Environment tab instead.

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# True locally. Render defaults to False when unset.
DEBUG=True

# Blank means use the local SQLite file.
# In production this is the Neon pooled connection string.
DATABASE_URL=

# Render adds its own hostname automatically via RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Used by the create_admin build step to create or update the staff account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Printed on the course registration form.
INSTITUTION_NAME=SchoolTry